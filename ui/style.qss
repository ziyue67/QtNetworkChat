/* ==========================================================================
   QtNetworkChat - QQNT Design System
   Light-first with runtime dark override via QWidget[theme="dark"].
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. Base / reset
   -------------------------------------------------------------------------- */
* {
    outline: none;
}

QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", "SF Pro Display", sans-serif;
    font-size: 14px;
}

/* --------------------------------------------------------------------------
   1.1 QQ-style startup / login windows
   -------------------------------------------------------------------------- */
QDialog#modeDialog,
QDialog#qqLoginDialog {
    background-color: #edf7ff;
    border: none;
}

QFrame#modeCard,
QFrame#qqFormCard {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #e7f6ff,
                                      stop:0.48 #fbfdff,
                                      stop:1 #f1f5ff);
    border: none;
}

QFrame#qqHeader {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #dff4ff,
                                      stop:0.55 #eef9ff,
                                      stop:1 #f3efff);
    border: none;
}

QLabel#logoLabel,
QLabel#brandLabel {
    color: #1296db;
    font-size: 28px;
    font-weight: 900;
    letter-spacing: 1px;
}

QLabel#qqTitle,
QLabel#accountNameLabel {
    color: #1f2329;
    font-size: 15px;
    font-weight: 700;
    padding-top: 8px;
}

QLabel#avatarLabel,
QLabel#qqAvatar {
    background-color: #ffffff;
    color: #1296db;
    border: 4px solid #ffffff;
    border-radius: 46px;
    font-size: 28px;
    font-weight: 900;
}

QLabel#serviceBadgeLabel {
    color: #1296db;
    background-color: rgba(18, 150, 219, 22);
    border: 1px solid rgba(18, 150, 219, 55);
    border-radius: 11px;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    margin-top: 6px;
}

QLabel#modeStatusLabel,
QLabel#formFeedbackLabel {
    color: #5f6672;
    font-size: 12px;
    font-weight: 600;
    line-height: 17px;
    padding: 8px 4px;
}

QPushButton#topIconBtn,
QPushButton#windowCloseBtn {
    background-color: rgba(255, 255, 255, 170);
    border: 1px solid rgba(18, 150, 219, 38);
    border-radius: 7px;
    color: #1f2329;
    font-size: 15px;
    font-weight: 700;
}

QPushButton#topIconBtn:hover,
QPushButton#windowCloseBtn:hover {
    background-color: #ffffff;
    border-color: #1296db;
    color: #1296db;
}

QPushButton#topIconBtn:pressed,
QPushButton#windowCloseBtn:pressed {
    background-color: #dff4ff;
}

QLineEdit#qqInput {
    min-height: 42px;
    background-color: #ffffff;
    color: #1f2329;
    border: 1px solid rgba(18, 150, 219, 38);
    border-radius: 18px;
    padding: 0 16px;
    selection-background-color: #1296db;
}

QLineEdit#qqInput:focus {
    border: 2px solid #1296db;
    background-color: #ffffff;
}

QLineEdit#qqInput::placeholder {
    color: #a7b0bd;
}

QCheckBox#agreementCheck,
QCheckBox {
    color: #5f6672;
    spacing: 7px;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border-radius: 8px;
    border: 1px solid #c9d3df;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #1296db;
    border-color: #1296db;
}

QPushButton#primaryBtn {
    min-height: 42px;
    background-color: #1296db;
    color: #ffffff;
    border: none;
    border-radius: 17px;
    font-size: 15px;
    font-weight: 800;
    padding: 0 18px;
}

QPushButton#primaryBtn:hover {
    background-color: #1089c8;
}

QPushButton#primaryBtn:pressed {
    background-color: #0d76ad;
}

QPushButton#primaryBtn:disabled {
    background-color: #aee0ff;
    color: rgba(255, 255, 255, 210);
}

QPushButton#linkBtn {
    background-color: transparent;
    border: none;
    color: #1296db;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 5px;
}

QPushButton#linkBtn:hover {
    color: #1089c8;
    text-decoration: underline;
}

QLabel#splitLabel {
    color: #c4ccd6;
    padding: 0 2px;
}

/* --------------------------------------------------------------------------
   2. Main window
   -------------------------------------------------------------------------- */
QMainWindow,
QWidget#centralwidget {
    background-color: #ffffff;
    border: none;
}

QWidget[theme="dark"] QMainWindow,
QWidget[theme="dark"] QWidget#centralwidget {
    background-color: #1e1e1e;
}

/* --------------------------------------------------------------------------
   3. Left navigation panel
   -------------------------------------------------------------------------- */
QFrame#appNavPanel {
    background-color: #f5f6f7;
    border-right: 1px solid #e1e3e6;
}

QWidget[theme="dark"] QFrame#appNavPanel {
    background-color: #252525;
    border-right: 1px solid #3a3a3a;
}

QFrame#appNavPanel QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #5f6672;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    font-size: 22px;
    padding: 0px;
    margin: 0px;
}

QFrame#appNavPanel QPushButton:hover {
    background-color: #ebedf0;
    color: #1f2329;
}

QFrame#appNavPanel QPushButton[navActive="true"] {
    background-color: #e6f4ff;
    color: #0099ff;
}

QWidget[theme="dark"] QFrame#appNavPanel QPushButton {
    color: #a8a8a8;
}

QWidget[theme="dark"] QFrame#appNavPanel QPushButton:hover {
    background-color: #2d2d2d;
    color: #e8e8e8;
}

QWidget[theme="dark"] QFrame#appNavPanel QPushButton[navActive="true"] {
    background-color: #1a3a52;
    color: #3da7ff;
}

QFrame#appNavPanel QPushButton:pressed {
    background-color: #e1e3e6;
}

QWidget[theme="dark"] QFrame#appNavPanel QPushButton:pressed {
    background-color: #3a3a3a;
}

/* --------------------------------------------------------------------------
   4. Session list panel
   -------------------------------------------------------------------------- */
QFrame#sessionListPanel {
    background-color: #f5f6f7;
    border-right: 1px solid #e1e3e6;
}

QWidget[theme="dark"] QFrame#sessionListPanel {
    background-color: #252525;
    border-right: 1px solid #3a3a3a;
}

QLabel#sessionHeaderLabel {
    color: #1f2329;
    font-size: 18px;
    font-weight: 700;
}

QWidget[theme="dark"] QLabel#sessionHeaderLabel {
    color: #e8e8e8;
}

QLineEdit#contactSearchEdit {
    background-color: #ffffff;
    border: 1px solid #e1e3e6;
    border-radius: 6px;
    padding: 6px 10px;
    color: #1f2329;
    selection-background-color: #0099ff;
}

QWidget[theme="dark"] QLineEdit#contactSearchEdit {
    background-color: #2d2d2d;
    border: 1px solid #3a3a3a;
    color: #e8e8e8;
}

QLineEdit#contactSearchEdit::placeholder {
    color: #8f959e;
}

QPushButton#globalSearchBtn,
QPushButton#createMenuBtn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #5f6672;
    font-size: 16px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px;
}

QPushButton#globalSearchBtn:hover,
QPushButton#createMenuBtn:hover {
    background-color: #ebedf0;
    color: #1f2329;
}

QWidget[theme="dark"] QPushButton#globalSearchBtn,
QWidget[theme="dark"] QPushButton#createMenuBtn {
    color: #a8a8a8;
}

QWidget[theme="dark"] QPushButton#globalSearchBtn:hover,
QWidget[theme="dark"] QPushButton#createMenuBtn:hover {
    background-color: #2d2d2d;
    color: #e8e8e8;
}

QListView#userListView {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0px;
}

QListView#userListView::item {
    border: none;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
    background-color: transparent;
}

QListView#userListView::item:selected,
QListView#userListView::item:hover {
    background-color: transparent;
}

/* Session profile footer */
QFrame#sessionProfilePanel {
    border-top: 1px solid #e1e3e6;
    background-color: #f5f6f7;
}

QWidget[theme="dark"] QFrame#sessionProfilePanel {
    border-top: 1px solid #3a3a3a;
    background-color: #252525;
}

QLabel#profileNameLabel {
    color: #1f2329;
    font-size: 14px;
    font-weight: 600;
}

QLabel#profileIdLabel {
    color: #8f959e;
    font-size: 12px;
}

QWidget[theme="dark"] QLabel#profileNameLabel {
    color: #e8e8e8;
}

QWidget[theme="dark"] QLabel#profileIdLabel {
    color: #787878;
}

QLabel#avatarLabel {
    background-color: #0099ff;
    color: #ffffff;
    border-radius: 22px;
    font-size: 18px;
    font-weight: 700;
}

QPushButton#uploadAvatarBtn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #5f6672;
    font-size: 16px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px;
}

QPushButton#uploadAvatarBtn:hover {
    background-color: #ebedf0;
    color: #0099ff;
}

QWidget[theme="dark"] QPushButton#uploadAvatarBtn {
    color: #a8a8a8;
}

QWidget[theme="dark"] QPushButton#uploadAvatarBtn:hover {
    background-color: #2d2d2d;
    color: #3da7ff;
}

/* --------------------------------------------------------------------------
   5. Chat panel
   -------------------------------------------------------------------------- */
QFrame#chatPanel {
    background-color: #ffffff;
}

QWidget[theme="dark"] QFrame#chatPanel {
    background-color: #1e1e1e;
}

QFrame#chatHeader {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    max-height: 48px;
    min-height: 48px;
}

QWidget[theme="dark"] QFrame#chatHeader {
    background-color: #1e1e1e;
    border-bottom: 1px solid #363636;
}

QLabel#chatTitleLabel {
    color: #1f2329;
    font-size: 16px;
    font-weight: 700;
}

QLabel#chatStatusLabel {
    color: #8f959e;
    font-size: 12px;
    margin-left: 8px;
}

QLabel#chatHintLabel {
    color: #8f959e;
    font-size: 12px;
}

QWidget[theme="dark"] QLabel#chatTitleLabel {
    color: #e8e8e8;
}

QWidget[theme="dark"] QLabel#chatStatusLabel,
QWidget[theme="dark"] QLabel#chatHintLabel {
    color: #787878;
}

QListView#chatListView {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0px;
}

QListView#chatListView::item {
    border: none;
    padding: 0px;
    margin: 0px;
    background-color: transparent;
}

QListView#chatListView::item:hover,
QListView#chatListView::item:selected {
    background-color: transparent;
}

QLabel#emptyChatLabel {
    color: #8f959e;
    font-size: 16px;
    background-color: transparent;
    qproperty-alignment: 'AlignCenter';
}

QWidget[theme="dark"] QLabel#emptyChatLabel {
    color: #787878;
}

/* --------------------------------------------------------------------------
   6. Chat input panel
   -------------------------------------------------------------------------- */
QFrame#chatInputPanel {
    background-color: #ffffff;
    border-top: 1px solid #e5e7eb;
}

QWidget[theme="dark"] QFrame#chatInputPanel {
    background-color: #1e1e1e;
    border-top: 1px solid #363636;
}

QLabel#composerStateLabel {
    color: #8f959e;
    font-size: 11px;
    background: transparent;
}

QWidget[theme="dark"] QLabel#composerStateLabel {
    color: #787878;
}

QTextEdit#messageEdit {
    background-color: #ffffff;
    border: 1px solid #e1e3e6;
    border-radius: 6px;
    padding: 8px;
    color: #1f2329;
    selection-background-color: #0099ff;
    selection-color: #ffffff;
}

QWidget[theme="dark"] QTextEdit#messageEdit {
    background-color: #262626;
    border: 1px solid #3a3a3a;
    color: #e8e8e8;
}

QTextEdit#messageEdit:focus {
    border: 1px solid #0099ff;
}

QWidget[theme="dark"] QTextEdit#messageEdit:focus {
    border: 1px solid #3da7ff;
}

QTextEdit#messageEdit::placeholder {
    color: #8f959e;
}

QPushButton#toolBtn,
QPushButton#iconToolBtn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #5f6672;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    font-size: 18px;
    padding: 0px;
}

QPushButton#toolBtn:hover,
QPushButton#iconToolBtn:hover {
    background-color: #ebedf0;
    color: #1f2329;
}

QWidget[theme="dark"] QPushButton#toolBtn,
QWidget[theme="dark"] QPushButton#iconToolBtn {
    color: #a8a8a8;
}

QWidget[theme="dark"] QPushButton#toolBtn:hover,
QWidget[theme="dark"] QPushButton#iconToolBtn:hover {
    background-color: #2d2d2d;
    color: #e8e8e8;
}

QWidget[theme="dark"] QPushButton#toolBtn:pressed,
QWidget[theme="dark"] QPushButton#iconToolBtn:pressed {
    background-color: #3a3a3a;
}

QPushButton#sendBtn {
    background-color: #0099ff;
    border: none;
    border-radius: 6px;
    color: #ffffff;
    font-weight: 600;
    min-width: 96px;
    max-width: 96px;
    min-height: 36px;
    max-height: 36px;
    padding: 0px;
}

QPushButton#sendBtn:hover {
    background-color: #007acc;
}

QPushButton#sendBtn:pressed {
    background-color: #006bb3;
}

QPushButton#sendBtn:disabled {
    background-color: #c2e6ff;
    color: #ffffff;
}

QWidget[theme="dark"] QPushButton#sendBtn {
    background-color: #3da7ff;
}

QWidget[theme="dark"] QPushButton#sendBtn:hover {
    background-color: #66c1ff;
}

QWidget[theme="dark"] QPushButton#sendBtn:pressed {
    background-color: #2e96ee;
}

QWidget[theme="dark"] QPushButton#sendBtn:disabled {
    background-color: #1f4a6b;
    color: #8f959e;
}

/* --------------------------------------------------------------------------
   7. Right group member panel
   -------------------------------------------------------------------------- */
QFrame#groupMemberPanel {
    background-color: #f5f6f7;
    border-left: 1px solid #e1e3e6;
    max-width: 256px;
    min-width: 256px;
}

QWidget[theme="dark"] QFrame#groupMemberPanel {
    background-color: #252525;
    border-left: 1px solid #3a3a3a;
}

QLabel#groupMemberHeaderLabel {
    color: #1f2329;
    font-size: 16px;
    font-weight: 700;
}

QWidget[theme="dark"] QLabel#groupMemberHeaderLabel {
    color: #e8e8e8;
}

QFrame#announcementCard {
    background-color: #ffffff;
    border: 1px solid #e1e3e6;
    border-radius: 6px;
}

QWidget[theme="dark"] QFrame#announcementCard {
    background-color: #262626;
    border: 1px solid #3a3a3a;
}

QLabel#announcementTitleLabel {
    color: #1f2329;
    font-size: 13px;
    font-weight: 700;
}

QLabel#announcementBodyLabel {
    color: #5f6672;
    font-size: 12px;
}

QWidget[theme="dark"] QLabel#announcementTitleLabel {
    color: #e8e8e8;
}

QWidget[theme="dark"] QLabel#announcementBodyLabel {
    color: #a8a8a8;
}

QLabel#memberTitleLabel {
    color: #5f6672;
    font-size: 12px;
}

QWidget[theme="dark"] QLabel#memberTitleLabel {
    color: #a8a8a8;
}

QLineEdit#memberSearchEdit {
    background-color: #ffffff;
    border: 1px solid #e1e3e6;
    border-radius: 6px;
    padding: 6px 10px;
    color: #1f2329;
}

QWidget[theme="dark"] QLineEdit#memberSearchEdit {
    background-color: #2d2d2d;
    border: 1px solid #3a3a3a;
    color: #e8e8e8;
}

QListView#groupMemberListView {
    background-color: transparent;
    border: none;
    outline: none;
}

QListView#groupMemberListView::item {
    border: none;
    border-radius: 4px;
    padding: 0px;
    margin: 1px 4px;
    background-color: transparent;
    color: #1f2329;
    min-height: 56px;
}

QListView#groupMemberListView::item:hover {
    background-color: #ebedf0;
}

QListView#groupMemberListView::item:selected {
    background-color: #e6f4ff;
    color: #0099ff;
}

QWidget[theme="dark"] QListView#groupMemberListView::item {
    color: #e8e8e8;
}

QWidget[theme="dark"] QListView#groupMemberListView::item:hover {
    background-color: #2d2d2d;
}

QWidget[theme="dark"] QListView#groupMemberListView::item:selected {
    background-color: #1a3a52;
    color: #3da7ff;
}

/* --------------------------------------------------------------------------
   8. Scrollbars
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 6px;
    margin: 2px 0px 2px 0px;
}

QScrollBar::handle:vertical {
    background-color: #c1c4c9;
    border-radius: 3px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8f959e;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 6px;
    margin: 0px 2px 0px 2px;
}

QScrollBar::handle:horizontal {
    background-color: #c1c4c9;
    border-radius: 3px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #8f959e;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QWidget[theme="dark"] QScrollBar::handle:vertical,
QWidget[theme="dark"] QScrollBar::handle:horizontal {
    background-color: #505050;
}

QWidget[theme="dark"] QScrollBar::handle:vertical:hover,
QWidget[theme="dark"] QScrollBar::handle:horizontal:hover {
    background-color: #6a6a6a;
}

/* --------------------------------------------------------------------------
   9. Menus / menubar / statusbar / dialogs
   -------------------------------------------------------------------------- */
QMenuBar {
    background-color: #f5f6f7;
    border-bottom: 1px solid #e1e3e6;
    padding: 2px 0px;
}

QWidget[theme="dark"] QMenuBar {
    background-color: #252525;
    border-bottom: 1px solid #3a3a3a;
}

QMenuBar::item {
    background: transparent;
    color: #5f6672;
    border-radius: 4px;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #ebedf0;
    color: #1f2329;
}

QWidget[theme="dark"] QMenuBar::item {
    color: #a8a8a8;
}

QWidget[theme="dark"] QMenuBar::item:selected {
    background-color: #2d2d2d;
    color: #e8e8e8;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e1e3e6;
    border-radius: 6px;
    padding: 4px;
}

QWidget[theme="dark"] QMenu {
    background-color: #262626;
    border: 1px solid #3a3a3a;
}

QMenu::item {
    color: #1f2329;
    border-radius: 4px;
    padding: 6px 24px 6px 12px;
}

QMenu::item:selected {
    background-color: #e6f4ff;
    color: #0099ff;
}

QWidget[theme="dark"] QMenu::item {
    color: #e8e8e8;
}

QWidget[theme="dark"] QMenu::item:selected {
    background-color: #1a3a52;
    color: #3da7ff;
}

QStatusBar {
    background-color: #f5f6f7;
    color: #8f959e;
    border-top: 1px solid #e1e3e6;
    font-size: 12px;
}

QWidget[theme="dark"] QStatusBar {
    background-color: #252525;
    color: #787878;
    border-top: 1px solid #3a3a3a;
}

QStatusBar::item {
    border: none;
}

QDialog,
QMessageBox,
QInputDialog,
QFileDialog {
    background-color: #ffffff;
}

QWidget[theme="dark"] QDialog,
QWidget[theme="dark"] QMessageBox,
QWidget[theme="dark"] QInputDialog,
QWidget[theme="dark"] QFileDialog {
    background-color: #1e1e1e;
}

QDialogButtonBox QPushButton {
    background-color: #f5f6f7;
    border: 1px solid #e1e3e6;
    border-radius: 6px;
    padding: 6px 14px;
    color: #1f2329;
}

QDialogButtonBox QPushButton:hover {
    background-color: #ebedf0;
}

QWidget[theme="dark"] QDialogButtonBox QPushButton {
    background-color: #2d2d2d;
    border: 1px solid #3a3a3a;
    color: #e8e8e8;
}

QWidget[theme="dark"] QDialogButtonBox QPushButton:hover {
    background-color: #363636;
}

QToolTip {
    background-color: #1f2329;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* --------------------------------------------------------------------------
   10. General inputs
   -------------------------------------------------------------------------- */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #e1e3e6;
    border-radius: 6px;
    padding: 6px 10px;
    color: #1f2329;
}

QLineEdit:focus {
    border: 1px solid #0099ff;
}

QLineEdit::placeholder {
    color: #8f959e;
}

QWidget[theme="dark"] QLineEdit {
    background-color: #262626;
    border: 1px solid #3a3a3a;
    color: #e8e8e8;
}

QWidget[theme="dark"] QLineEdit:focus {
    border: 1px solid #3da7ff;
}

QTextEdit {
    background-color: #ffffff;
    border: 1px solid #e1e3e6;
    border-radius: 6px;
    color: #1f2329;
    selection-background-color: #0099ff;
}

QWidget[theme="dark"] QTextEdit {
    background-color: #262626;
    border: 1px solid #3a3a3a;
    color: #e8e8e8;
}

QPushButton {
    background-color: #f5f6f7;
    border: 1px solid #e1e3e6;
    border-radius: 6px;
    padding: 6px 14px;
    color: #1f2329;
}

QPushButton:hover {
    background-color: #ebedf0;
}

QPushButton:pressed {
    background-color: #e1e3e6;
}

QWidget[theme="dark"] QPushButton {
    background-color: #2d2d2d;
    border: 1px solid #3a3a3a;
    color: #e8e8e8;
}

QWidget[theme="dark"] QPushButton:hover {
    background-color: #363636;
}

QComboBox,
QSpinBox {
    background-color: #ffffff;
    border: 1px solid #e1e3e6;
    border-radius: 6px;
    padding: 4px 8px;
    color: #1f2329;
}

QWidget[theme="dark"] QComboBox,
QWidget[theme="dark"] QSpinBox {
    background-color: #262626;
    border: 1px solid #3a3a3a;
    color: #e8e8e8;
}

QProgressBar {
    background-color: #ebedf0;
    border: none;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #0099ff;
    border-radius: 4px;
}

QWidget[theme="dark"] QProgressBar {
    background-color: #2d2d2d;
}

QWidget[theme="dark"] QProgressBar::chunk {
    background-color: #3da7ff;
}

/* --------------------------------------------------------------------------
   11. Keep legacy chat bubble painter hints happy.
   -------------------------------------------------------------------------- */
QListView#chatListView {
    background-color: transparent;
}
