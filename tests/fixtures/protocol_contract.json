    "disconnect",
    "login",
    "register",
    "logout",
    "set_user_info",
    "get_user_list",
    "get_friend_list",
    "get_group_list",
    "search_friend",
    "send_friend_request",
    "respond_friend_request",
    "send_private_message",
    "send_group_message",
    "create_group",
    "update_group_announcement",
    "update_group_member",
    "send_file",
    "send_image",
    "cancel_transfer",
    "query_resume",
    "e2e_status",
    "e2e_announce_identity",
    "e2e_pin_identity",
    "e2e_request_rotation",
    "profile_update",
    "settings_sync"
