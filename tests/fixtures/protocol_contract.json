{
  "protocolVersion": 1,
  "commands": [
    "ready",
    "connect",
    "disconnect",
    "login",
    "register",
    "logout",
    "set_user_info",
    "get_user_list",
    "get_friend_list",
    "get_group_list",
    "search_friend",
    "send_friend_request",
    "respond_friend_request",
    "send_private_message",
    "send_group_message",
    "create_group",
    "update_group_announcement",
    "update_group_member",
    "send_file",
    "send_image",
    "cancel_transfer",
    "query_resume",
    "e2e_status",
    "e2e_announce_identity",
    "e2e_pin_identity",
    "e2e_request_rotation",
    "profile_update",
    "settings_sync"
  ],
  "commandPayloads": {
    "ready": "{}",
    "connect": "{host, port}",
    "disconnect": "{}",
    "login": "{account, password}",
    "register": "{account, password, userName}",
    "logout": "{}",
    "set_user_info": "{userId, userName}",
    "get_user_list": "{}",
    "get_friend_list": "{}",
    "get_group_list": "{}",
    "search_friend": "{account}",
    "send_friend_request": "{receiverId}",
    "respond_friend_request": "{senderId, accepted}",
    "send_private_message": "{receiverId, content}",
    "send_group_message": "{groupId, content}",
    "create_group": "{groupName, members?, announcement?}",
    "update_group_announcement": "{groupId, announcement}",
    "update_group_member": "{groupId, memberId, action}",
    "send_file": "{receiverId xor groupId, filePath}",
    "send_image": "{receiverId xor groupId, filePath}",
    "cancel_transfer": "{transferId}",
    "query_resume": "{transferId, filePath?, receiverId xor groupId?, contentType?}",
    "e2e_status": "{peerId?}",
    "e2e_announce_identity": "{peerId}",
    "e2e_pin_identity": "{peerId, fingerprint?}",
    "e2e_request_rotation": "{peerId}",
    "profile_update": "{userName?, avatarBase64?}",
    "settings_sync": "{settings}"
  },
  "events": [
    "ready",
    "connection_state",
    "login_result",
    "user_list",
    "user_joined",
    "user_left",
    "friend_event",
    "friend_search_result",
    "message",
    "group_snapshot",
    "group_member_updated",
    "file_progress",
    "file_done",
    "file_error",
    "e2e_session_state",
    "e2e_identity_state",
    "e2e_rotation_request",
    "e2e_rotation_response",
    "settings_synced",
    "notification",
    "error"
  ],
  "eventPayloads": {
    "ready": "{protocolVersion, version, qtVersion, e2eStatus}",
    "connection_state": "{connected, host, port}",
    "login_result": "{success, userId, userName, error?}",
    "user_list": "{users}",
    "user_joined": "{userId, userName}",
    "user_left": "{userId, userName}",
    "friend_event": "{type, senderId?, senderName?, receiverId?, accepted?, delivered?}",
    "friend_search_result": "{found, userId, userName, online}",
    "message": "{sessionId, message}",
    "group_snapshot": "{groups}",
    "group_member_updated": "{groupId, memberId, action}",
    "file_progress": "{transferId, fileName, bytes, total, direction}",
    "file_done": "{transferId, fileName, filePath, direction}",
    "file_error": "{transferId, reason}",
    "e2e_session_state": "{peerId, rotationRequired}",
    "e2e_identity_state": "{peerId, trusted, fingerprint}",
    "e2e_rotation_request": "{peerId, agreement}",
    "e2e_rotation_response": "{peerId, agreement, accepted, reason?}",
    "settings_synced": "{accepted, revision, settings, appliedDownloadDir?}",
    "notification": "{title, body}",
    "error": "{message, source}"
  }
}
