  "commandPayloads": {
    "ready": "{}",
    "connect": "{host, port}",
    "disconnect": "{}",
    "login": "{account, password}",
    "register": "{account, password, userName}",
    "logout": "{}",
    "set_user_info": "{userId, userName}",
    "get_user_list": "{}",
    "get_friend_list": "{}",
    "get_group_list": "{}",
    "search_friend": "{account}",
    "send_friend_request": "{receiverId}",
    "respond_friend_request": "{senderId, accepted}",
    "send_private_message": "{receiverId, content}",
    "send_group_message": "{groupId, content}",
    "create_group": "{groupName, members?: string[]/memberRef[], announcement?}",
    "update_group_announcement": "{groupId, announcement}",
    "update_group_member": "{groupId, memberId, action=add/remove/promote_admin/demote_admin}",
    "send_file": "{receiverId xor groupId, filePath}",
    "send_image": "{receiverId xor groupId, filePath}",
    "cancel_transfer": "{transferId}",
    "query_resume": "{transferId, filePath?, receiverId xor groupId?, contentType?}",
    "e2e_status": "{peerId?}",
    "e2e_announce_identity": "{peerId}",
    "e2e_pin_identity": "{peerId, fingerprint?}",
    "e2e_request_rotation": "{peerId}",
    "profile_update": "{userName?, avatarBase64?}",
    "settings_sync": "{settings}"
  },
  "ackPayloads": {
    "ready": "{protocolVersion, version, qtVersion, e2eStatus}",
    "connect": "{connected, host, port}",
    "disconnect": "{}",
    "login": "{accepted, requiresConnect, mode=login}",
    "register": "{accepted, requiresConnect, mode=register}",
    "logout": "{}",
    "set_user_info": "{}",
    "get_user_list": "{users}",
    "get_friend_list": "{friends}",
    "get_group_list": "{groups, removedGroups, hasSnapshot}",
    "search_friend": "{accepted}",
    "send_friend_request": "{accepted}",
    "respond_friend_request": "{accepted}",
    "send_private_message": "{receiverId}",
    "send_group_message": "{accepted}",
    "create_group": "{accepted}",
    "update_group_announcement": "{accepted}",
    "update_group_member": "{accepted}",
    "send_file": "{accepted}",
    "send_image": "{accepted}",
    "cancel_transfer": "{cancelled, transferId}",
    "query_resume": "{canResume, transferId, confirmedBytes, nextChunkIndex, fileSize, chunkSize, chunkCount, fileHash, receivedChunks, resumed, mode}",
    "e2e_status": "{localIdentity, peerId?, session?, identity?}",
    "e2e_announce_identity": "{accepted}",
    "e2e_pin_identity": "{accepted}",
    "e2e_request_rotation": "{accepted}",
    "profile_update": "{accepted, avatarSent, userName}",
    "settings_sync": "{accepted, revision, settings, appliedDownloadDir?}"
  },
  "events": [
    "ready",
    "connection_state",
    "login_result",
    "user_list",
    "user_joined",
    "user_left",
    "friend_list",
    "friend_event",
    "friend_search_result",
    "message",
    "group_snapshot",
    "group_member_updated",
    "file_progress",
    "file_done",
    "file_error",
    "e2e_session_state",
    "e2e_identity_state",
    "e2e_rotation_request",
    "e2e_rotation_response",
    "settings_synced",
    "notification",
    "error"
  ],
  "eventPayloads": {
    "ready": "{protocolVersion, version, qtVersion, e2eStatus}",
    "connection_state": "{connected, host, port}",
    "login_result": "{success, userId?, userName?, registered?, error?}",
    "user_list": "{users}",
    "user_joined": "{userId, userName}",
    "user_left": "{userId, userName}",
    "friend_list": "{friends}",
    "friend_event": "{type, senderId?, senderName?, receiverId?, accepted?, delivered?}",
