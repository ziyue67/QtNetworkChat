{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QQ NT",
  "version": "0.1.0",
  "identifier": "com.jun23.qqnt",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QQ NT",
        "label": "main",
        "width": 1100,
        "height": 740,
        "minWidth": 860,
        "minHeight": 540,
        "decorations": false,
        "transparent": false,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": []
  }
}
