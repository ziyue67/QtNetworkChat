####### Build rules

first: all
all: Makefile.pro.Debug  bin/QtNetworkChat.exe

bin/QtNetworkChat.exe: D:/Qt/6.8.3/mingw_64/lib/libQt6Widgets.a D:/Qt/6.8.3/mingw_64/lib/libQt6Multimedia.a D:/Qt/6.8.3/mingw_64/lib/libQt6Gui.a D:/Qt/6.8.3/mingw_64/lib/libQt6Network.a D:/Qt/6.8.3/mingw_64/lib/libQt6Sql.a D:/Qt/6.8.3/mingw_64/lib/libQt6Core.a D:/Qt/6.8.3/mingw_64/lib/libQt6EntryPoint.a build/ui/ui_mainwindow.h $(OBJECTS) 
	$(LINKER) $(LFLAGS) -o $(DESTDIR_TARGET) @build\obj\object_script.QtNetworkChat.Debug $(LIBS)
	if not exist "D:\C++VS pro\QtNetworkChat\bin\ui" mkdir "D:\C++VS pro\QtNetworkChat\bin\ui" 
	 copy /y "D:\C++VS pro\QtNetworkChat\ui\style-qqnt.qss" "D:\C++VS pro\QtNetworkChat\bin\ui\style-qqnt.qss" 
	 copy /y "D:\C++VS pro\QtNetworkChat\ui\style-qqnt-dark.qss" "D:\C++VS pro\QtNetworkChat\bin\ui\style-qqnt-dark.qss" 
	 if not exist "D:\C++VS pro\QtNetworkChat\bin\sqldrivers" mkdir "D:\C++VS pro\QtNetworkChat\bin\sqldrivers" 
	 copy /y "D:\Qt\6.8.3\mingw_64\plugins\sqldrivers\qsqlite.dll" "D:\C++VS pro\QtNetworkChat\bin\sqldrivers\qsqlite.dll" 
	

qmake: FORCE
	@$(QMAKE) -o Makefile.pro.Debug QtNetworkChat.pro

qmake_all: FORCE

